<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.rpg.controller.CriarNovoPersonagemFX">
   <VBox alignment="CENTER" layoutX="250.0" layoutY="100.0" prefHeight="200.0" prefWidth="100.0" spacing="25.0" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="150.0" AnchorPane.topAnchor="100.0">
      <Label text="Criação de herói" textAlignment="CENTER">
         <font>
            <Font name="Berry Rotunda Regular" size="16.0" />
         </font>
      </Label>
      <TextField fx:id="campoNomeHeroiTextField" alignment="CENTER" promptText="Digite o nome do seu herói">
         <font>
            <Font name="Berry Rotunda Regular" size="14.0" />
         </font></TextField>
      <ComboBox fx:id="comboClasseComboBox" prefWidth="150.0" promptText="Selecione sua classe" />
      <Button mnemonicParsing="false" onAction="#onBotaoConfirmarClick" text="Confirmar">
         <font>
            <Font name="Berry Rotunda Regular" size="12.0" />
         </font></Button>
      <Label fx:id="mensagemErroLabel" textFill="RED">
         <font>
            <Font name="Berry Rotunda Regular" size="14.0" />
         </font></Label>
   </VBox>
</AnchorPane>
