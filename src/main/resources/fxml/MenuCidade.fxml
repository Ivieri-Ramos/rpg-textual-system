<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.rpg.controller.MenuCidadeControllerFX">
    <VBox alignment="CENTER" layoutX="250.0" layoutY="100.0" prefHeight="200.0" prefWidth="100.0" spacing="15.0" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="150.0" AnchorPane.topAnchor="100.0">
        <Button mnemonicParsing="false" onAction="#onBotaoMenuMasmorrasClick" text="Masmorras" textAlignment="CENTER">
         <font>
            <Font name="Berry Rotunda Regular" size="14.0" />
         </font></Button>
        <Button mnemonicParsing="false" onAction="#onBotaoSalvarJogoClick" text="Salvar o Jogo">
         <font>
            <Font name="Berry Rotunda Regular" size="14.0" />
         </font></Button>
        <Button mnemonicParsing="false" onAction="#onBotaoSalvarESairJogoClick" text="Salvar e Sair do Jogo">
         <font>
            <Font name="Berry Rotunda Regular" size="14.0" />
         </font></Button>
    </VBox>
    <VBox layoutX="14.0" layoutY="14.0" prefHeight="200.0" prefWidth="100.0" spacing="15.0">
      <children>
         <Label fx:id="nomeHeroiLabel" prefHeight="18.0" prefWidth="90.0">
            <font>
               <Font name="Berry Rotunda Regular" size="14.0" />
            </font></Label>
      </children>
      <padding>
         <Insets left="10.0" top="10.0" />
      </padding></VBox>
    <Label fx:id="nomeCidadeLabel" alignment="CENTER" contentDisplay="CENTER" layoutY="90.0" prefHeight="18.0" prefWidth="150.0" textAlignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
      <font>
         <Font name="Berry Rotunda Regular" size="16.0" />
      </font></Label>
</AnchorPane>
